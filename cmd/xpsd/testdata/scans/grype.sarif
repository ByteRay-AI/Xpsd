          "rules": [
            {
              "id": "GHSA-v778-237x-gjrc-golang.org/x/crypto",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GHSA-v778-237x-gjrc critical vulnerability for golang.org/x/crypto package"
              },
              "fullDescription": {
                "text": "Misuse of ServerConfig.PublicKeyCallback may cause authorization bypass in golang.org/x/crypto"
              },
              "helpUri": "https://github.com/advisories/GHSA-v778-237x-gjrc",
              "help": {
                "text": "Vulnerability GHSA-v778-237x-gjrc\nSeverity: critical\nPackage: golang.org/x/crypto\nVersion: v0.17.0\nFix Version: 0.31.0\nType: go-module\nLocation: /app/go.mod\nData Namespace: github:language:go\nLink: [GHSA-v778-237x-gjrc](https://github.com/advisories/GHSA-v778-237x-gjrc)",
                "markdown": "**Vulnerability GHSA-v778-237x-gjrc**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | golang.org/x/crypto  | v0.17.0  | 0.31.0  | go-module  | /app/go.mod  | github:language:go  | [GHSA-v778-237x-gjrc](https://github.com/advisories/GHSA-v778-237x-gjrc)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/golang.org/x/crypto@v0.17.0"
                ],
                "security-severity": "9.1"
              }
            },
